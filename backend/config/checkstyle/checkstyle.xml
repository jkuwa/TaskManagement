<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
	Checkstyle の設定ファイル（コードの書き方のチェック）
	./gradlew check（または ./gradlew checkstyleMain checkstyleTest）で実行される。

	このプロジェクトのコード（タブで字下げ・日本語のコメントが長い）に合わせて、
	バグにつながりやすい書き方と、名前の付け方のルールだけを入れている。
	- 入れていないもの：字下げの幅（Indentation）、1行の長さ（LineLength）、Javadoc を必ず書く系のルール
	ルールの説明：https://checkstyle.org/checks.html
-->
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="error"/>

	<!-- ファイルの最後に改行があるか -->
	<module name="NewlineAtEndOfFile"/>

	<module name="TreeWalker">
		<!-- ===== import ===== -->
		<!-- import java.util.*; のような * を使った import をしない（何を使っているか分かりにくくなる） -->
		<module name="AvoidStarImport"/>
		<!-- 使っていない import を残さない -->
		<module name="UnusedImports"/>
		<!-- 同じものを2回 import したり、java.lang や同じパッケージのものを import したりしない -->
		<module name="RedundantImport"/>

		<!-- ===== バグにつながりやすい書き方 ===== -->
		<!-- if / for / while の中身が1行でも { } を付ける（あとから行を足したときの間違いを防ぐ） -->
		<module name="NeedBraces"/>
		<!-- 中身が空の { } を作らない（書き忘れの可能性がある） -->
		<module name="EmptyBlock">
			<property name="option" value="text"/>
		</module>
		<!-- 例外を受け取って何もしない catch を作らない -->
		<module name="EmptyCatchBlock"/>
		<!-- equals を書いたら hashCode も書く（片方だけだと HashMap などで正しく動かない） -->
		<module name="EqualsHashCode"/>
		<!-- switch には default を書く -->
		<module name="MissingSwitchDefault"/>
		<!-- case の処理が break などなしで次の case に流れ込まないようにする -->
		<module name="FallThrough"/>
		<!-- 文字列を == で比べない（中身ではなく同じオブジェクトかを比べてしまう。equals を使う） -->
		<module name="StringLiteralEquality"/>
		<!-- 1行に文を2つ以上書かない -->
		<module name="OneStatementPerLine"/>
		<!-- int a, b; のように1行で複数の変数を宣言しない -->
		<module name="MultipleVariableDeclarations"/>
		<!-- 修飾子の順番を Java の推奨どおりにする（例：public static final の順） -->
		<module name="ModifierOrder"/>
		<!-- long の数値の末尾は小文字の l ではなく大文字の L にする（1 と見間違えないように） -->
		<module name="UpperEll"/>
		<!-- 配列の型は String[] args の形で書く（String args[] にしない） -->
		<module name="ArrayTypeStyle"/>

		<!-- ===== 名前の付け方 ===== -->
		<!-- クラス・インターフェース・record：大文字で始める（例：TaskService） -->
		<module name="TypeName"/>
		<!-- メソッド：小文字で始める（例：findAll） -->
		<module name="MethodName"/>
		<!-- フィールド：小文字で始める（例：taskRepository） -->
		<module name="MemberName"/>
		<!-- static final の定数：大文字とアンダースコア（例：MAX_TITLE_LENGTH） -->
		<module name="ConstantName"/>
		<!-- ローカル変数・引数：小文字で始める -->
		<module name="LocalVariableName"/>
		<module name="LocalFinalVariableName"/>
		<module name="ParameterName"/>
		<module name="LambdaParameterName"/>
		<!-- パッケージ：すべて小文字 -->
		<module name="PackageName"/>
	</module>
</module>
